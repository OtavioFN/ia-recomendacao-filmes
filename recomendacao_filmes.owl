<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/recomendacao-filmes.owl"
         xmlns="http://example.org/recomendacao-filmes.owl#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="http://example.org/recomendacao-filmes.owl"/>

<owl:ObjectProperty rdf:about="#temGenero">
  <rdfs:domain rdf:resource="#ObraAudiovisual"/>
  <rdfs:range rdf:resource="#Genero"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temDiretor">
  <rdfs:domain rdf:resource="#ObraAudiovisual"/>
  <rdfs:range rdf:resource="#Diretor"/>
  <owl:inverseOf rdf:resource="#dirigiu"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#dirigiu">
  <owl:inverseOf rdf:resource="#temDiretor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#disponivelEm">
  <rdfs:domain rdf:resource="#ObraAudiovisual"/>
  <rdfs:range rdf:resource="#Plataforma"/>
  <owl:inverseOf rdf:resource="#oferece"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#oferece">
  <owl:inverseOf rdf:resource="#disponivelEm"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#assinaPlataforma">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#Plataforma"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#assistiu">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#ObraAudiovisual"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#gostouDe">
  <rdfs:subPropertyOf rdf:resource="#assistiu"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#prefereGenero">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#Genero"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#gostouDe"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#temGenero"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#prefereDiretor">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#Diretor"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#gostouDe"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#temDiretor"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#recomendadoPara">
  <rdfs:domain rdf:resource="#ObraAudiovisual"/>
  <rdfs:range rdf:resource="#Usuario"/>
  <owl:inverseOf rdf:resource="#temRecomendacao"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temRecomendacao">
  <owl:inverseOf rdf:resource="#recomendadoPara"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#titulo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ObraAudiovisual"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nome">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Pessoa"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#idade">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#idadeMinima">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ObraAudiovisual"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#anoLancamento">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ObraAudiovisual"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#duracaoMin">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Filme"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#numTemporadas">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Serie"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#notaMedia">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ObraAudiovisual"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#ObraAudiovisual">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#disponivelEm"/>
      <owl:someValuesFrom rdf:resource="#Plataforma"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#idadeMinima"/>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#temGenero"/>
      <owl:someValuesFrom rdf:resource="#Genero"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Filme">
  <rdfs:subClassOf rdf:resource="#ObraAudiovisual"/>
  <owl:disjointWith rdf:resource="#Serie"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#temDiretor"/>
      <owl:someValuesFrom rdf:resource="#Diretor"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Serie">
  <rdfs:subClassOf rdf:resource="#ObraAudiovisual"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#numTemporadas"/>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Genero">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Plataforma">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Pessoa">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Diretor">
  <rdfs:subClassOf rdf:resource="#Pessoa"/>
</owl:Class>

<owl:Class rdf:about="#Usuario">
  <rdfs:subClassOf rdf:resource="#Pessoa"/>
</owl:Class>

<owl:Class rdf:about="#ObraDeFiccaoCientifica">
  <rdfs:subClassOf rdf:resource="#ObraAudiovisual"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ObraAudiovisual"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temGenero"/>
          <owl:hasValue rdf:resource="#FiccaoCientifica"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ObraDeAcao">
  <rdfs:subClassOf rdf:resource="#ObraAudiovisual"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ObraAudiovisual"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temGenero"/>
          <owl:hasValue rdf:resource="#Acao"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ObraInfantil">
  <rdfs:subClassOf rdf:resource="#ObraAudiovisual"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ObraAudiovisual"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#idadeMinima"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</xsd:maxInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ObraAdulta">
  <rdfs:subClassOf rdf:resource="#ObraAudiovisual"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ObraAudiovisual"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#idadeMinima"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ObraAclamada">
  <rdfs:subClassOf rdf:resource="#ObraAudiovisual"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ObraAudiovisual"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#notaMedia"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8.0</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Minisserie">
  <rdfs:subClassOf rdf:resource="#Serie"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Serie"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#numTemporadas"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:maxInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#UsuarioMenorDeIdade">
  <rdfs:subClassOf rdf:resource="#Usuario"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Usuario"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#idade"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</xsd:maxInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

